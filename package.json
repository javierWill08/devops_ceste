{
  "name": "test",
  "version": "1.0.0",
  "description": "Proyecto de prueba para el curso de DevOps",
  "main": "index.test.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javierWill08/devops_ceste.git"
  },
  "bugs": {
    "url": "https://github.com/javierWill08/devops_ceste/issues"
  },
  "homepage": "https://github.com/javierWill08/devops_ceste#readme",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
